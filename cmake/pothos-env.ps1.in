# The environment for the stage prefix of PothosBase (generated by CMake).
# Dot-source it in PowerShell: . @PROJECT_BINARY_DIR@/pothos-env.ps1
# Run "ctest -R base.stage" (or the full ctest) first to fill the stage prefix.
$env:POTHOS_ROOT = "@stage_dir@"
$env:PATH = "@stage_dir@/@CMAKE_INSTALL_BINDIR@;" + $env:PATH
#only the modules of the stage prefix
Remove-Item Env:POTHOS_PLUGIN_PATH -ErrorAction SilentlyContinue
