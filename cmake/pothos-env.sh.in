# The environment for the stage prefix of PothosBase (generated by CMake).
# Source it in a bash or zsh shell: source @PROJECT_BINARY_DIR@/pothos-env.sh
# Then run PothosUtil of the stage prefix, also under a debugger:
#   gdb --args PothosUtil --self-test1 /blocks/tests/test_copier_domain_crossing
# Run "ctest -R base.stage" (or the full ctest) first to fill the stage prefix.
export POTHOS_ROOT="@stage_dir@"
export PATH="@stage_dir@/@CMAKE_INSTALL_BINDIR@:$PATH"
export @library_path_var@="@stage_dir@/@CMAKE_INSTALL_LIBDIR@${@library_path_var@:+:$@library_path_var@}"
#only the modules of the stage prefix
unset POTHOS_PLUGIN_PATH
